{
  "name": "semicolon-list-extension",
  "displayName": "Semicolon List Extension",
  "description": "Convert selected semicolon-separated text into a bullet list",
  "version": "0.0.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:semicolonList.convert"
  ],
  "contributes": {
    "commands": [
      {
        "command": "semicolonList.convert",
        "title": "Convert semicolon list"
      }
    ],
    "keybindings": [
      {
        "command": "semicolonList.convert",
        "key": "ctrl+alt+b",
        "when": "editorTextFocus && editorLangId == markdown"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  }
}