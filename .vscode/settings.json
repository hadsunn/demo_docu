    "languageToolLinter.managed.classPath": "c:\\Users\\kulikov-i\\Documents\\work\\Docu\\LanguageTool-6.6\\languagetool-server.jar",
    "languageTool.language": "auto",
    "languageToolLinter.serviceType": "managed",
    "languageTool.fileTypes": ["markdown", "mdx"],
    "languageTool.strength": "normal",
    "languageTool.enableErrors": ["grammar", "style"],
    "mdx-preview.preview.enableScripts": true,
    "cSpell.language": "en,ru",
    "replacerules.rulesets": {
      "Shift all headers": {
        "rules": ["Shift ####", "Shift ###", "Shift ##", "Shift #"]
      },
      "Fix all for DS": {
        "rules": [
          "Delete old TOC", "Delete 1st page", "Replace emf", "Delete reg changes list",
          "Shift ####", "Shift ###", "Shift ##", "Shift #",
          "Fix warnings", "Fix infos", "Fix warnings 2", "Fix infos 2",
          "Fix images",  "Fix images3", "Fix images3", "Fix code lines",
          "Fix <> escapes", "Fix _ escapes", "Fix /< escapes", "Fix /> escapes"
        ]
      }
      
  },
    "replacerules.rules": {
      "Shift ####": {
        "find": "^#### ",
        "replace": "##### ",
      },
      "Shift ###": {
          "find": "^### ",
          "replace": "#### ",
      },
      "Shift ##": {
          "find": "^## ",
          "replace": "### ",
      },
      "Shift #": {
          "find": "^# ",
          "replace": "## ",
      },
      "Fix images": {
          "find": "<img src=[^>]+\\.\/assets\/images\/([^\/]+)\/media\/image(\\d+)\\.(png|PNG)\" style=[^\n]+",
          "replace": "\n\n![](@site/docs/assets/images/$1/media/image$2.png)",
      },
      "Fix images2": {
          "find": "<img src=[^>]+\\.\\/docs\\/assets\\/images\\/([^\\/]+)\\/([\\s\\S]*?)\\/media\\/image(\\d+)\\.(png|PNG)\" style=[^\\n]+",
          "replace": "\n![](@site/docs/assets/images/$1/$2/media/image$3.png))",
      },
      "Fix images3": {
          "find": "<figure>\\n<img src=[^>]+\\.\\/docs\\/assets\\/images\\/([^\\/]+)\\/([\\s\\S]*?)\\/media\\/image(\\d+)\\.(png|PNG)\" style=[^\\n]+\\n<figcaption><p>(Рисунок[\\s\\S]*?)<.p>[\\s\\S]*?<\\/figure>",
          "replace": "![](@site/docs/assets/images/$1/$2/media/image$3.png)\n\n$5",
      },
      "Fix warnings": {
          "find": "\\| <img src=[^>]+\\.\/assets/images\/([^\/]+)\/media/image1\\.png\" style=\"[^\"]*\" /> \\| ([^|]+) \\|\n\\|----\\|----\\|",
          "replace": ":::warning Важная информация\n$2\n:::",
      },
      "Fix warnings 2": {
          /* конструкция ужасна, но пока ничего лучше не придумал для этих типов предупреждений */
          "find": "<table>\\n<colgroup>\\n<col style=\"width: \\d+%\" \\/>\\n<col style=\"width: \\d+%\" \\/>\\n<\\/colgroup>\\n<thead>\\n<tr>\\n<th .*?image1.png.*?<\\/th>\\n<th><p>(.*)<\\/p>\\n<p>(.*)<\\/p>[\\s\\S]*?<\\/table>",
          "replace": ":::warning Важная информация\n$1\n\n$2\n:::",
      },
      "Fix infos": {
          "find": "\\| <img src=[^>]+\\.\/assets/images\/([^\/]+)\/media/image2\\.png\" style=\"[^\"]*\" /> \\| ([^|]+) \\|\n\\|----\\|----\\|",
          "replace": ":::info Дополнительная информация\n$2\n:::",
      },
      "Fix infos 2": {
          "find": "<table>\\n<colgroup>\\n<col style=\"width: \\d+%\" \\/>\\n<col style=\"width: \\d+%\" \\/>\\n<\\/colgroup>\\n<thead>\\n<tr>\\n<th .*?image2.png.*?<\\/th>\\n<th><p>(.*)<\\/p>\\n<p>(.*)<\\/p>[\\s\\S]*?<\\/table>",
          "replace": ":::info Дополнительная информация\n$1\n\n$2\n:::",
      },
      "Delete old TOC": {
          "find": "\\*\\*СОДЕРЖАНИЕ\\*\\*\n[\\s|\\S]*# Назначение компонент(а|ов)",
          "replace": "# Назначение компонента",
      },
      "Delete 1st page": {
          "find": "<table>\n[\\s\\S]*?\\*\\*АННОТАЦИЯ\\*\\*",
          "replace": "**АННОТАЦИЯ**",
      },
      "Replace emf": {
          "find": ".emf\\)",
          "replace": ".png)",
      },
      "Delete reg changes list": {
          /* Поиск последней таблицы идет с помощью Перечня сокращений, его таблица сохраняется, таблица Листа удаляется */
          "find": "^(\\| <span id[\\s\\S]*?Перечень сокращений[\\s\\S]*?\n)(<table>\n[\\s\\S]*?Лист регистрации изменений[\\s\\S]*?<\/table>\n)",
          "replace": "$1",
      },
      "Fix code lines": {
          "find": "(> )(\\\\# )([\\s\\S]*?\\n)",
          "replace": "```\n# $3```\n",
      },
      "Fix <> escapes": {
          "find": "\\\\<ver\\\\>",
          "replace": "<ver>",
      },
      "Fix /< escapes": {
          "find": "\\\\<",
          "replace": "<",
      },
      "Fix /> escapes": {
          "find": "\\\\>",
          "replace": ">",
      },
      "Fix _ escapes": {
          "find": "\\\\_",
          "replace": "_",
      },
      "Fix jatoba escapes": {
          /* пока не юзаем, * без экрана потом ломает текст */
          "find": "jatoba\\\\",
          "replace": "jatoba",
      },

  }
}
